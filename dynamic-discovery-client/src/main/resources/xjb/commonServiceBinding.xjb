<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings version="2.0" xmlns:jaxb="http://java.sun.com/xml/ns/jaxb"
               xmlns:xjc="http://java.sun.com/xml/ns/jaxb/xjc"
               jaxb:extensionBindingPrefixes="xjc"
               xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <jaxb:globalBindings xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <jaxb:javaType name="java.time.OffsetDateTime" xmlType="xs:dateTime"
                       parseMethod="eu.europa.ec.dynamicdiscovery.util.DatatypeConverter.parseDateTime"
                       printMethod="eu.europa.ec.dynamicdiscovery.util.DatatypeConverter.printDateTime"/>
        <jaxb:javaType name="java.time.OffsetDateTime" xmlType="xs:date"
                       parseMethod="eu.europa.ec.dynamicdiscovery.util.DatatypeConverter.parseDateTime"
                       printMethod="eu.europa.ec.dynamicdiscovery.util.DatatypeConverter.printDateTime"/>
       <xjc:simple/>
    </jaxb:globalBindings>
</jaxb:bindings>
